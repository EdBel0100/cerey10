# =================================
# Root-level ignores
# =================================

# Node modules (all folders)
**/node_modules/
**/pnpm-lock.yaml
**/package-lock.json
**/yarn.lock

# Environment variables
**/.env
**/.env.*  

# Logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# =================================
# Frontend (Expo / React Native)
# =================================
frontend/.expo/
frontend/.expo-shared/
frontend/.vscode/
frontend/web-build/
frontend/dist/
frontend/.expo/web-build/

# Build artifacts
frontend/.expo/ios/
frontend/.expo/android/
frontend/build/
frontend/.expo-kit/

# Expo secrets
frontend/secrets.json

# =================================
# Backend (NestJS / Prisma)
backend/dist/
backend/node_modules/
backend/.vscode/
# Keep the lockfile
!backend/pnpm-lock.yaml

# =================================
# Infrastructure (AWS CDK)
# =================================
infrastructure/cdk.out/
infrastructure/node_modules/
infrastructure/.env
infrastructure/.vscode/

# =================================
# Misc
# =================================
*.swp
*.swo
*.tmp
